{
  "name": "swe-job-watch",
  "version": "1.0.0",
  "description": "Daily job opening watcher for public ATS boards with Google Sheets output.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/index.ts",
    "start": "node --env-file=.env dist/index.js",
    "build": "tsc",
    "dry-run": "DRY_RUN=true node --env-file=.env --import tsx src/index.ts",
    "check": "node --env-file=.env --import tsx src/index.ts --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:workflow": "node --env-file=.env --import tsx scripts/test-workflow.ts",
    "test:companies": "node --import tsx scripts/test-company-apis.ts"
  },
  "keywords": [
    "jobs",
    "ashby",
    "greenhouse",
    "lever",
    "oracle",
    "smartrecruiters",
    "workday",
    "google-sheets"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.21.0",
    "googleapis": "^171.4.0",
    "nodemailer": "^10.0.9",
    "openai": "^7.15.0",
    "pino": "^9.14.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.19.2",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
